# -------------------------------------------------------------
# Supabase Database (BACKUP)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Comma-separated list of admin emails allowed
ADMIN_EMAILS=jhuggitaleemiproject@gmail.com,gjtfoundation1@gmail.com,admin@gjtfoundation.com

# Site URL for SEO and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------
# Google Drive Storage Driver (Payment Proofs)
# -------------------------------------------------------------
# Primary storage driver: "google-drive"
PROOF_STORAGE_DRIVER=google-drive

# Google OAuth 2.0 Client credentials (obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Persistent OAuth Refresh Token for the dedicated Google Drive account
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Target Root Folder ID in Google Drive (must be created manually or auto-created in drive.file mode)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# Scope mode: "drive" (default, uses existing root folder) or "drive.file" (app-managed folder)
GOOGLE_DRIVE_SCOPE_MODE=drive

# Proof file naming mode: "reference" (e.g. GJTF-2026-000123_proof-1_20261016-1432.webp) or "random" (uuid)
PROOF_FILENAME_MODE=reference

# -------------------------------------------------------------
# Security & Envelope Encryption
# -------------------------------------------------------------
# "off" (default - allows direct viewing in Google Drive UI) or "on" (AES-256-GCM envelope encryption)
PROOF_ENCRYPTION=off

# 32-byte hex master key (required ONLY if PROOF_ENCRYPTION=on). Generate with: openssl rand -hex 32
PROOF_MASTER_KEY=

# -------------------------------------------------------------
# Application Timezone & Scheduled Crons
# -------------------------------------------------------------
APP_TIMEZONE=Asia/Karachi

# Secret token used by Vercel Crons or external schedulers (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-cron-secret-token-here
